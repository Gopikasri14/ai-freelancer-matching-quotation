# Application Settings
ENVIRONMENT=development
PROJECT_NAME="AI Freelancer Matching and Quotation Optimization System"
API_V1_PREFIX=/api/v1
DEBUG=True

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# Database (To be configured in Milestone 3)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=freelancer_db

# Security & JWT (To be configured in Milestone 5)
SECRET_KEY=change-this-in-production-to-a-secure-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
